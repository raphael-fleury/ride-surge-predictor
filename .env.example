# ============================================
# Ride Surge Predictor - Environment Variables
# ============================================

PORT=8000
TRAINING_INTERVAL_HOURS=24
EDA_INTERVAL_HOURS=24

API_URL=https://standing-wombat-211.convex.site # Dev Environment Url

# Uber Login Credentials
# Email used for Uber account login during web scraping
uber_email=your_uber_email@example.com

# SMTP Configuration for Email Notifications
# These variables are used to send email notifications when Uber session expires
# and requires manual re-authentication.

# SMTP Server Address (default: smtp.gmail.com)
SMTP_SERVER=smtp.gmail.com

# SMTP Server Port (default: 587)
SMTP_PORT=587

# SMTP Account Username/Email for authentication
SMTP_USER=your_email@gmail.com

# SMTP Account Password or App-specific Password
# Note: For Gmail, use an App Password if 2FA is enabled
# See: https://support.google.com/accounts/answer/185833
SMTP_PASS=your_app_password_here
